[Unit]
Description=Print Portal (web upload + local agent queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=printportal
Group=printportal
WorkingDirectory=/opt/print-portal
EnvironmentFile=/etc/print-portal.env
ExecStart=/opt/print-portal/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8099 --timeout 120 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
